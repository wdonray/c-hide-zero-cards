{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "model_api": {
      "models": {
        "muse-spark-1.3": {
          "limit": { "context": 1048576, "output": 131072 },
          "name": "Muse Spark 1.3"
        }
      },
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MODEL_API_KEY}",
        "baseURL": "https://api.meta.ai/v1"
      }
    }
  }
}
